# ---- Server ----
PORT=5000
NODE_ENV=development

# Exact origin of the React app. Used for CORS. No trailing slash.
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/mern_auth
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mern_auth
MONGO_URI=

# ---- Authentication ----
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# "lax" when client and API share a site (normal local development).
# "none" when they are on different sites in production — requires HTTPS.
COOKIE_SAME_SITE=lax

# ---- Brevo SMTP (Nodemailer) ----
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
MAIL_FROM="MERN Auth <you@yourdomain.com>"
